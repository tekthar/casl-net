<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- The same model and random rule sets as the SQLite equivalence test. -->
  <ItemGroup>
    <Compile Include="..\Casl.Net.Tests\Model.cs" Link="Shared\Model.cs" />
    <Compile Include="..\Casl.Net.Tests\RandomRules.cs" Link="Shared\RandomRules.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Casl.Net\Casl.Net.csproj" />
  </ItemGroup>

</Project>
