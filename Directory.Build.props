<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <Authors>Tekthar and CASL .NET contributors</Authors>
    <Company>Tekthar</Company>
    <Copyright>Copyright 2026 CASL .NET contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/tekthar/casl-net</PackageProjectUrl>
    <RepositoryUrl>https://github.com/tekthar/casl-net</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>authorization;permissions;abac;rbac;casl;ef-core;linq;row-level-security;field-level-security</PackageTags>
    <PackageReleaseNotes>https://github.com/tekthar/casl-net/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <VersionPrefix>0.2.0</VersionPrefix>

    <!-- Debugging into the package: SourceLink (built into the .NET SDK) and a symbol package next to the .nupkg. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
